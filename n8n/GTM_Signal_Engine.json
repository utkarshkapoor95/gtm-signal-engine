    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction getTier(item) {\n  return String(item.json.signal_tier || '').trim().toUpperCase();\n}\n\nconst critical = items.filter(i => getTier(i) === 'CRITICAL');\nconst hot = items.filter(i => getTier(i) === 'HOT');\nconst warm = items.filter(i => getTier(i) === 'WARM');\n\nconst MAX_LISTED = 25;\n\nfunction compactList(arr) {\n  let out = '';\n  const shown = arr.slice(0, MAX_LISTED);\n  for (const a of shown) {\n    out += `• ${a.json.company_name}: ${a.json.signal_score} | ${String(a.json.signal_type).replace(/_/g, ' ')}\\n`;\n  }\n  if (arr.length > MAX_LISTED) {\n    out += `...and ${arr.length - MAX_LISTED} more\\n`;\n  }\n  return out;\n}\n\nconst now = new Date();\nconst dateStr = now.toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });\nconst timeStr = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });\n\nlet msg = `📊 GTM SIGNAL ENGINE REPORT\\n`;\nmsg += `${dateStr} at ${timeStr}\\n`;\nmsg += `━━━━━━━━━━━━━━━━━━━━━━\\n\\n`;\nmsg += `📈 Total accounts flagged: ${items.length}\\n`;\nmsg += `🔴 Critical (85+): ${critical.length}\\n`;\nmsg += `🟠 Hot (70-84): ${hot.length}\\n`;\nmsg += `🟡 Warm (50-69): ${warm.length}\\n\\n`;\n\nif (critical.length > 0) {\n  msg += `━━ 🔴 CRITICAL ━━━━━━━━━\\n`;\n  msg += compactList(critical);\n  msg += `\\n`;\n}\n\nif (hot.length > 0) {\n  msg += `━━ 🟠 HOT ━━━━━━━━━━━━━\\n`;\n  msg += compactList(hot);\n  msg += `\\n`;\n}\n\nif (warm.length > 0) {\n  msg += `━━ 🟡 WARM ━━━━━━━━━━━━\\n`;\n  msg += compactList(warm);\n  msg += `\\n`;\n}\n\nmsg += `━━━━━━━━━━━━━━━━━━━━━━\\n`;\nmsg += `✅ ${items.length} contacts synced to HubSpot\\n`;\nmsg += `⏰ Next check in 4 hours`;\n\nreturn [{ json: { summary: msg, total: items.length, critical_count: critical.length, hot_count: hot.length, warm_count: warm.length } }];"
      },
